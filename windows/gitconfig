# Windows overrides for git/gitconfig.
#
# ~/.gitconfig on Windows is a small stub written by install.ps1 that includes
# git/gitconfig first and THIS file second, so only what differs from macOS lives
# here. (A stub rather than a symlink to git/gitconfig: git has no OS-conditional
# include, so the shared file cannot pull this one in by itself.)

# core.autocrlf = input is set in TWO places on purpose. Git for Windows' system
# config says true, which checks files out with CRLF, so either copy missing is a
# regression:
#   - the ~/.gitconfig stub (install.ps1): outside the worktree, so it survives a
#     checkout of any commit that lacks this file - the primary copy;
#   - here: covers a machine whose stub predates the stub copy, until install.ps1
#     is re-run (a pull alone would otherwise leave it with neither).
# See docs/solutions/cross-machine/windows-target-gotchas-2026-09-24.md.
[core]
    autocrlf = input

# credential.helper is multi-valued: an empty value resets the list inherited
# from git/gitconfig (osxkeychain + the /usr/local GCM path, neither of which
# exists here) before the Windows helper is added.
[credential]
    helper =
    helper = manager
[credential "https://github.com"]
    helper =
    helper = !'C:/Program Files/GitHub CLI/gh.exe' auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !'C:/Program Files/GitHub CLI/gh.exe' auth git-credential
