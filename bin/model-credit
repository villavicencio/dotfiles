#!/usr/bin/env bash
#
# model-credit — the lines each model changed in a ticket's merged work, and the `model` label
# the rule gives. Symlinked to ~/.local/bin/model-credit.
#
#   model-credit <ticket-id> [--repo owner/name ...] [--no-linear]    e.g. model-credit VIL-852
#
# The rule is docs/agents/tickets.md, "Model credit"; the Python is bin/lib/model-credit.py.
# It only reads (Linear through op-agent, GitHub through gh, the local clone), so it has no
# DOTFILES_DRY_RUN guard. Checks: ci/model-credit-checks.sh.
set -euo pipefail
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
exec python3 "$(cd "$(dirname "$self")" && pwd -P)/lib/model-credit.py" "$@"
