[meta]
name = "com.googlecode.iterm2"
mode = "dark"
description = "Imported from Iterm2 on 2026-07-14"

[terminal]
foreground = "#C0C3CB"
background = "#031B21"
cursor = "#C678DE"
cursor-text = "#ABB2BF"
selection-foreground = "#ABB2BF"
selection-background = "#323844"
palette = [
    "#21252B", "#C98389", "#9AB488", "#E5C07B", 
    "#7DACD3", "#BB8CC9", "#56B6C2", "#ABB2BF", 
    "#767676", "#C98389", "#9AB488", "#E5C07B", 
    "#7DACD3", "#BB8CC9", "#56B6C2", "#ABB2BF", 
]

[token]
foreground = "#C0C3CB"
accent = "#7DACD3"

[panel]
surface = "#0E252B"
border = "#253940"

